// Le Garage — primary database schema.
// Source of truth for physical schema; conceptual explanation lives in
// /docs/DATABASE.md and /docs/DOMAIN.md. Keep them in sync when this changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  MANAGER
  FRONT_DESK
  TECHNICIAN
  PLATFORM_ADMIN
}

/// What kind of business a tenant is (docs/FLEET.md). Same tenancy,
/// auth and Job workflow either way — `kind` only changes which side of a
/// repair the organization sits on: a GARAGE repairs other people's
/// vehicles for Customers; a FLEET company maintains its own vehicles and
/// coordinates external ServiceProviders. Defaults to GARAGE so every
/// pre-existing organization keeps its behavior.
enum OrganizationKind {
  GARAGE
  FLEET
  /// Le Garage's own internal organization — the home of PLATFORM_ADMIN
  /// staff (docs/ADMIN.md). Never created by signup; it has no customers,
  /// vehicles, or jobs of its own.
  PLATFORM
}

/// Operational availability of a vehicle (fleet orgs). IN_MAINTENANCE is
/// set/cleared automatically as repairs open/close (JobsService);
/// UNAVAILABLE and RETIRED are manual manager decisions.
enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  UNAVAILABLE
  RETIRED
}

enum VehicleType {
  CAR
  PICKUP
  VAN
  TRUCK
  MINIBUS
  BUS
  MOTORCYCLE
  OTHER
}

enum FuelType {
  DIESEL
  PETROL
  HYBRID
  ELECTRIC
  OTHER
}

/// What a photo/document is evidence of (docs/FLEET.md §"Vehicle profile").
/// Optional — older attachments have none.
enum AttachmentTag {
  VEHICLE_PROFILE
  CONDITION
  DAMAGE
  BEFORE_REPAIR
  AFTER_REPAIR
  OLD_PART
  RECEIPT
  DOCUMENT
}

enum Currency {
  ETB
}

enum JobStatus {
  INTAKE
  DIAGNOSING
  WAITING_APPROVAL
  APPROVED
  WAITING_PARTS
  IN_PROGRESS
  QUALITY_CHECK
  READY
  COLLECTED
  ON_HOLD
  CANCELLED
  CLOSED
}

enum EstimateStatus {
  DRAFT
  SENT
  SUPERSEDED
  APPROVED
  REJECTED
}

enum EstimateItemType {
  PART
  LABOR
}

enum ApprovalMethod {
  IN_APP
  VERBAL_LOGGED_BY_STAFF
  PHONE
  /// An authorized staff member of the organization made the decision
  /// themselves — a fleet manager approving their own company's repair
  /// spend. Only valid for FLEET organizations (ApprovalsService).
  STAFF_DECISION
  /// A fleet customer's authorized staff decided on a garage's estimate
  /// through their own Le Garage account (docs/WORK-ORDERS.md). Written
  /// only by WorkOrderSyncService — never accepted from a request body.
  FLEET_PORTAL
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum PartCondition {
  NEW
  USED
  REFURBISHED
}

enum PartSource {
  GARAGE_SUPPLIED
  CUSTOMER_SUPPLIED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum PaymentMethod {
  CASH
  TELEBIRR
  BANK_TRANSFER
  OTHER
}

enum AttachmentEntityType {
  JOB
  DIAGNOSIS
  ESTIMATE
  VEHICLE
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  TELEGRAM
  WHATSAPP
  IN_APP
}

/// docs/WORK-ORDERS.md: a fleet company sending one of its repairs to a
/// garage that is also on Le Garage.
enum WorkOrderStatus {
  SENT
  ACCEPTED
  DECLINED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────
// Identity & tenancy
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffMemberships StaffMember[]
  refreshTokens    RefreshToken[]
  auditLogEntries  AuditLog[]     @relation("AuditLogActor")
  customerLinks    CustomerLink[]
  notifications    Notification[]

  @@index([email])
  @@index([phone])
}

/// Which session type this refresh token belongs to (docs/DECISIONS.md
/// ADR-0020). A single User can hold both a STAFF session (garage-web)
/// and an OWNER session (owner-mobile) at once — the same person can work
/// at a garage and separately own a car serviced elsewhere — so "kind" is
/// a property of the *session*, not the user. Rotation must preserve it.
enum TokenKind {
  STAFF
  OWNER
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       TokenKind @default(STAFF)
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Organization {
  id              String           @id @default(uuid())
  name            String
  /// Set by a platform admin: the org's staff can no longer sign in or use
  /// the API until it is reactivated (docs/ADMIN.md). Data is kept intact.
  suspendedAt     DateTime?
  suspendedReason String?
  kind            OrganizationKind @default(GARAGE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  garage           Garage?
  customers        Customer[]
  vehicles         Vehicle[]
  jobs             Job[]
  staff            StaffMember[]
  auditLogs        AuditLog[]
  serviceProviders ServiceProvider[]
}

model Garage {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String
  phone         String?
  address       String?
  city          String    @default("Addis Ababa")
  businessHours Json?
  verifiedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff StaffMember[]
  jobs  Job[]
}

model StaffMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  garageId       String
  garage         Garage       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedJobs     Job[]      @relation("AssignedTechnician")
  decidedApprovals Approval[] @relation("ApprovalDecidedByStaff")

  @@unique([garageId, userId])
  @@index([organizationId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Customers & Vehicles
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fullName String
  phone    String
  email    String?
  notes    String?

  /// When this customer is itself a fleet company on Le Garage — the
  /// record a garage's work-order jobs are filed under (docs/WORK-ORDERS.md).
  linkedOrganizationId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  jobs          Job[]
  ownedVehicles VehicleOwnerHistory[]
  approvals     Approval[]            @relation("ApprovalDecidedByCustomer")
  ownerLinks    CustomerLink[]

  @@index([organizationId, phone])
  @@index([organizationId, fullName])
}

model Vehicle {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vin              String?
  licensePlate     String
  make             String
  model            String
  year             Int?
  color            String?
  lastKnownMileage Int?
  vehicleType      VehicleType?
  status           VehicleStatus @default(ACTIVE)

  // Vehicle profile (fleet orgs, docs/FLEET.md). Driver is plain contact
  // details for now — drivers don't have accounts yet.
  fuelType    FuelType?
  acquiredAt  DateTime?
  driverName  String?
  driverPhone String?
  notes       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  ownerHistory   VehicleOwnerHistory[]
  jobs           Job[]
  attachments    Attachment[]
  serviceRecords ServiceRecord[]

  // VIN is unique per tenant, not globally: the same physical vehicle can
  // legitimately exist in a fleet company's register *and* a garage's
  // records, and a global constraint leaked VIN existence across tenants.
  @@unique([organizationId, vin])
  @@index([organizationId, licensePlate])
  @@index([organizationId])
  @@index([organizationId, status])
}

/// Links an owner-mobile identity (User, with no staff membership) to a
/// garage-side Customer record — potentially one per organization the same
/// real person has used (docs/OWNER-APP.md §"Owner/garage relationship").
/// Deliberately its own join table rather than a userId column on Customer:
/// a Customer row is garage-owned data that predates any owner account, and
/// linking must be an explicit, confirmed action (docs/OPEN_QUESTIONS.md
/// #3 — matched by phone, never silently auto-merged), not an automatic
/// side effect of matching phone numbers.
model CustomerLink {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organizationId String

  createdAt DateTime @default(now())

  @@unique([userId, customerId])
  @@index([userId])
  @@index([customerId])
}

model VehicleOwnerHistory {
  id         String   @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([vehicleId])
  @@index([customerId])
}

/// An external garage/service provider in a FLEET organization's private
/// directory (docs/FLEET.md). Org-owned data like Customer: another tenant
/// can never see it. Providers have no login in the first release — the
/// fleet's own staff record their estimates and invoices (manager-led).
model ServiceProvider {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  phone   String?
  address String?
  notes   String?
  active  Boolean @default(true)

  /// Set when this provider is a garage that uses Le Garage itself — repairs
  /// can then be sent to it as work orders it accepts and works in its own
  /// account (docs/WORK-ORDERS.md). Null = an offline garage the fleet's own
  /// staff record estimates and bills for.
  garageOrganizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([organizationId])
  @@index([garageOrganizationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Job Card — the spine
// ─────────────────────────────────────────────────────────────────────────

model Job {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  garageId       String
  garage         Garage       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  /// Required for GARAGE orgs (who brought the car in); always null for
  /// FLEET orgs, where the organization itself owns the vehicle.
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// FLEET orgs only: the external garage doing the work, from the
  /// organization's own private provider directory.
  serviceProviderId String?
  serviceProvider   ServiceProvider? @relation(fields: [serviceProviderId], references: [id], onDelete: NoAction)

  assignedTechnicianId String?
  assignedTechnician   StaffMember? @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id])

  status          JobStatus @default(INTAKE)
  complaint       String
  mileageAtIntake Int?

  intakeAt          DateTime  @default(now())
  diagnosingAt      DateTime?
  waitingApprovalAt DateTime?
  approvedAt        DateTime?
  inProgressAt      DateTime?
  qualityCheckAt    DateTime?
  readyAt           DateTime?
  collectedAt       DateTime?
  cancelledAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  statusEvents  JobStatusEvent[]
  diagnoses     Diagnosis[]
  notes         JobNote[]
  estimates     Estimate[]
  approvals     Approval[]
  parts         JobPart[]
  labor         JobLabor[]
  invoices      Invoice[]
  attachments   Attachment[]
  serviceRecord ServiceRecord?

  @@index([organizationId, status])
  @@index([organizationId, vehicleId])
  @@index([organizationId, customerId])
  @@index([organizationId, assignedTechnicianId])
  @@index([organizationId, serviceProviderId])
}

model JobStatusEvent {
  id    String @id @default(uuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  fromStatus  JobStatus?
  toStatus    JobStatus
  actorUserId String?
  note        String?
  createdAt   DateTime   @default(now())

  @@index([jobId])
}

model Diagnosis {
  id             String @id @default(uuid())
  organizationId String
  jobId          String
  job            Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  authorStaffId     String
  observedProblem   String
  suspectedCause    String?
  confirmedCause    String?
  severity          String?
  recommendedRepair String?
  notes             String?

  /// On a fleet repair: the garage diagnosis this is a copy of (work orders).
  externalDiagnosisId String? @unique

  createdAt DateTime @default(now())

  attachments Attachment[]

  @@index([jobId])
  @@index([organizationId])
}

/// Freeform technician/staff log entries on a job — distinct from Diagnosis
/// (structured problem/cause/severity findings) and JobLabor (billable
/// work performed): a quick note like "waiting on customer callback" or
/// "test drove, no more noise" doesn't fit either. Append-only, like
/// Diagnosis (docs/DOMAIN.md §3).
model JobNote {
  id             String @id @default(uuid())
  organizationId String
  jobId          String
  job            Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  authorStaffId String
  note          String

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Estimates (versioned) & Approvals
// ─────────────────────────────────────────────────────────────────────────

model Estimate {
  id             String @id @default(uuid())
  organizationId String
  jobId          String
  job            Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  version  Int
  status   EstimateStatus @default(DRAFT)
  currency Currency       @default(ETB)

  subtotal      Int @default(0)
  taxTotal      Int @default(0)
  discountTotal Int @default(0)
  total         Int @default(0)

  createdByStaffId String
  createdAt        DateTime  @default(now())
  sentAt           DateTime?
  decidedAt        DateTime?

  supersedesEstimateId String?

  /// On a fleet repair: the garage's estimate this is a copy of (work orders).
  externalEstimateId String? @unique

  /// An unguessable token letting a customer view this specific estimate
  /// read-only, no account required (docs/PRODUCT.md §"Customer Approval
  /// Experience", brief §21 "customer-facing estimate"). Generated lazily
  /// on first "Share with customer" click, not on every estimate. Looked
  /// up without an organizationId — a customer has no tenant context — so
  /// it must be cryptographically unguessable; see FilesService-style
  /// prismaUnscoped reasoning in apps/api/src/estimates.
  shareToken String? @unique

  items       EstimateItem[]
  approvals   Approval[]
  attachments Attachment[]

  @@unique([jobId, version])
  @@index([jobId])
  @@index([organizationId])
}

model EstimateItem {
  id         String   @id @default(uuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  type           EstimateItemType
  description    String
  quantity       Int              @default(1)
  unitPrice      Int
  discount       Int              @default(0)
  lineTotal      Int
  /// On a fleet copy: the garage estimate line this mirrors.
  externalItemId String?

  createdAt DateTime @default(now())

  approvalDecisions ApprovalItemDecision[]

  @@index([estimateId])
}

model Approval {
  id             String   @id @default(uuid())
  organizationId String
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  estimateId     String
  estimate       Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  method              ApprovalMethod
  decidedByCustomerId String?
  decidedByCustomer   Customer?      @relation("ApprovalDecidedByCustomer", fields: [decidedByCustomerId], references: [id])
  loggedByStaffId     String?
  /// Who actually made the decision, when it was made by staff rather than
  /// the customer (method STAFF_DECISION — fleet manager approvals).
  decidedByStaffId    String?
  decidedByStaff      StaffMember?   @relation("ApprovalDecidedByStaff", fields: [decidedByStaffId], references: [id], onDelete: NoAction)
  note                String?

  createdAt DateTime @default(now())

  itemDecisions ApprovalItemDecision[]

  @@index([jobId])
  @@index([estimateId])
  @@index([organizationId])
}

model ApprovalItemDecision {
  id             String       @id @default(uuid())
  approvalId     String
  approval       Approval     @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  estimateItemId String
  estimateItem   EstimateItem @relation(fields: [estimateItemId], references: [id], onDelete: Cascade)

  decision ApprovalDecision

  @@unique([approvalId, estimateItemId])
}

// ─────────────────────────────────────────────────────────────────────────
// Parts & Labor (job-scoped, MVP — see DOMAIN.md §3)
// ─────────────────────────────────────────────────────────────────────────

model JobPart {
  id             String @id @default(uuid())
  organizationId String
  jobId          String
  job            Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name           String
  partNumber     String?
  brand          String?
  condition      PartCondition @default(NEW)
  source         PartSource    @default(GARAGE_SUPPLIED)
  supplier       String?
  quantity       Int           @default(1)
  unitCost       Int?
  unitPrice      Int
  warrantyMonths Int?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([organizationId])
}

model JobLabor {
  id             String @id @default(uuid())
  organizationId String
  jobId          String
  job            Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  description       String
  technicianStaffId String?
  hours             Float?
  rate              Int?
  amount            Int

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Invoicing & Payments
// ─────────────────────────────────────────────────────────────────────────

/// Versioned like Estimate (docs/DOMAIN.md §6, docs/DATABASE.md §8): a
/// DRAFT invoice is mutable in place (regenerated as parts/labor change),
/// but once ISSUED it is frozen — a correction VOIDs it and a new version
/// is generated, linked via supersedesInvoiceId. Never edited after issue.
model Invoice {
  id             String @id @default(uuid())
  organizationId String
  jobId          String
  job            Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  version  Int
  status   InvoiceStatus @default(DRAFT)
  currency Currency      @default(ETB)

  subtotal      Int @default(0)
  taxTotal      Int @default(0)
  discountTotal Int @default(0)
  total         Int @default(0)

  supersedesInvoiceId String?

  /// On a fleet repair: the garage invoice this is a copy of (work orders).
  externalInvoiceId String?   @unique
  issuedAt          DateTime?
  voidedAt          DateTime?

  createdByStaffId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@unique([jobId, version])
  @@index([jobId])
  @@index([organizationId])
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Which JobPart/JobLabor kind this line was generated from — drives
  /// spend-by-category reporting. Null on invoices generated before this
  /// column existed.
  type        EstimateItemType?
  description String
  quantity    Int               @default(1)
  unitPrice   Int
  discount    Int               @default(0)
  lineTotal   Int

  @@index([invoiceId])
}

model Payment {
  id             String  @id @default(uuid())
  organizationId String
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount    Int
  method    PaymentMethod
  reference String?
  paidAt    DateTime      @default(now())
  voidedAt  DateTime?

  recordedByStaffId String
  createdAt         DateTime @default(now())

  @@index([invoiceId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Attachments, Service History, Audit, Notifications
// ─────────────────────────────────────────────────────────────────────────

model Attachment {
  id             String @id @default(uuid())
  organizationId String

  entityType  AttachmentEntityType
  jobId       String?
  job         Job?                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  diagnosisId String?
  diagnosis   Diagnosis?           @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  estimateId  String?
  estimate    Estimate?            @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  vehicleId   String?
  vehicle     Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  objectKey            String
  mimeType             String
  sizeBytes            Int
  uploadedByStaffId    String
  tag                  AttachmentTag?
  caption              String?
  /// On a fleet repair: the garage attachment this is a copy of (work orders).
  externalAttachmentId String?        @unique

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([jobId])
  @@index([vehicleId])
}

model ServiceRecord {
  id        String  @id @default(uuid())
  jobId     String  @unique
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  organizationId String
  garageId       String

  serviceDate DateTime
  mileage     Int?
  summary     Json

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([organizationId])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  entityType  String
  entityId    String
  action      String
  actorUserId String?
  actorUser   User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  beforeState Json?
  afterState  Json?

  createdAt DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([createdAt])
}

/// Foundation only — an in-app notification record (docs/OWNER-APP.md
/// §"Notifications"). Real push delivery (device token registration,
/// actually calling Expo's push service) is deliberately not built yet;
/// `channel`/`status` exist so that layer can be added later without a
/// schema change, but today every row is created as IN_APP/SENT and read
/// by the owner app polling `GET /owner/notifications` — see
/// docs/OPEN_QUESTIONS.md.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  type    String
  title   String
  body    String
  payload Json?
  status  NotificationStatus  @default(PENDING)
  readAt  DateTime?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([userId])
  @@index([userId, readAt])
}

/// Backs the Idempotency-Key protection on critical mutations (docs/API.md
/// §1, docs/SECURITY.md — "duplicate action protection"). A caller-supplied
/// key is unique per (organizationId, route); a second request with the
/// same key while the first is still PENDING is rejected, and once
/// COMPLETED the original response is replayed rather than re-executed.
/// Rows are not currently swept — see docs/OPEN_QUESTIONS.md.
model IdempotencyRecord {
  id             String @id @default(uuid())
  organizationId String
  route          String
  key            String
  status         String // PENDING | COMPLETED
  responseStatus Int?
  responseBody   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, route, key])
  @@index([organizationId])
}

/// A fleet repair sent to a garage on Le Garage (docs/WORK-ORDERS.md). The
/// one record that spans two tenants: each side keeps its own Job, and this
/// links them. Always queried by fleetOrganizationId or garageOrganizationId
/// (tenant-scope guard, "two-sided" models).
model WorkOrder {
  id                   String  @id @default(uuid())
  fleetOrganizationId  String
  fleetJobId           String
  garageOrganizationId String
  garageJobId          String? @unique
  serviceProviderId    String

  status        WorkOrderStatus @default(SENT)
  message       String?
  declineReason String?

  sentByUserId      String
  respondedByUserId String?
  sentAt            DateTime  @default(now())
  respondedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([fleetOrganizationId, status])
  @@index([fleetJobId])
  @@index([garageOrganizationId, status])
}
