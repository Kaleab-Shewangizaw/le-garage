NODE_ENV=development
PORT=4000

# Port must match infrastructure/docker/docker-compose.yml's postgres port
# mapping — it defaults to 5442 on the host (not 5432) to avoid clashing
# with other Postgres instances that may already be running on a dev
# machine. Adjust if you changed that mapping.
DATABASE_URL=postgresql://legarage:legarage@localhost:5442/legarage?schema=public

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# Deliberately a *different* secret from JWT_ACCESS_SECRET — owner-mobile
# and garage-web sessions must never verify against one another's tokens,
# even if a guard had a bug (docs/DECISIONS.md ADR-0020).
JWT_OWNER_ACCESS_SECRET=dev-owner-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Object storage (MinIO locally via docker-compose, S3 in production).
# S3_ENDPOINT must be reachable from BOTH the API process and the
# browser, since presigned URLs are generated server-side but used
# client-side — see docs/DEVELOPMENT.md "Running Garage Web".
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=legarage-attachments
S3_ACCESS_KEY=legarage
S3_SECRET_KEY=legarage123
S3_FORCE_PATH_STYLE=true
