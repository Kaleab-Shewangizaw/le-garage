NODE_ENV=development
PORT=4000

# Port must match infrastructure/docker/docker-compose.yml's postgres port
# mapping — it defaults to 5442 on the host (not 5432) to avoid clashing
# with other Postgres instances that may already be running on a dev
# machine. Adjust if you changed that mapping.
DATABASE_URL=postgresql://legarage:legarage@localhost:5442/legarage?schema=public

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGIN=http://localhost:3000
